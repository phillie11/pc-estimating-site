# Copy to .env and fill in. Never commit .env.
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=yourportal.com,www.yourportal.com,yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourportal.com,https://www.yourportal.com
SITE_URL=https://yourportal.com
PRODUCT_NAME=Siteline
SUPPORT_EMAIL=support@yourportal.com
# Change this so the admin isn't at a guessable address
ADMIN_PATH=platform-admin

# Database (PythonAnywhere > Databases tab)
DB_ENGINE=mysql
DB_NAME=yourusername$siteline
DB_USER=yourusername
DB_PASSWORD=
DB_HOST=yourusername.mysql.pythonanywhere-services.com

# Uploaded files: keep OUTSIDE any static mapping
MEDIA_ROOT=/home/yourusername/siteline-files
MAX_UPLOAD_MB=50

# Email (any SMTP provider: Microsoft 365, Postmark, SendGrid, Mailgun)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Siteline <no-reply@yourportal.com>

# Stripe (Dashboard > Developers > API keys / Webhooks; Products > price IDs)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_BUSINESS=price_...
TRIAL_DAYS=14
PAYMENT_GRACE_DAYS=7

# Cloud file storage. Leave STORAGE_BUCKET empty to keep files on this server's disk.
# AWS S3 London: region eu-west-2, no endpoint needed.
# DigitalOcean Spaces London: STORAGE_ENDPOINT_URL=https://lon1.digitaloceanspaces.com, STORAGE_REGION=lon1
# Cloudflare R2 (EU): STORAGE_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com, STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_REGION=eu-west-2
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LINK_SECONDS=300
