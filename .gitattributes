# Shell scripts and the Docker build must keep Unix line endings, even when checked out on Windows
*.sh            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.py            text eol=lf
*.tf            text eol=lf
*.hcl           text eol=lf
*.tfvars        text eol=lf
*.yml           text eol=lf
# PowerShell scripts with Windows line endings
*.ps1           text eol=crlf
